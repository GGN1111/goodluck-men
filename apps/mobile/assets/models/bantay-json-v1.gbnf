# bantay-json-v1.gbnf — llama.cpp grammar for contracts/bantay-analysis.schema.json
# Constrained decoding makes malformed JSON structurally impossible (research R3).
# Fixed key order matches the contract; strings allow standard JSON escapes.

root   ::= object

object ::=
  "{" ws "\"schema_version\"" ws ":" ws "\"1.0\"" ws ","
  ws "\"analysis_id\"" ws ":" ws string ws ","
  ws "\"source\"" ws ":" ws source ws ","
  ws "\"crisis_type\"" ws ":" ws crisis_type ws ","
  ws "\"bantay_state\"" ws ":" ws bantay_state ws ","
  ws "\"status\"" ws ":" ws status ws ","
  ws "\"location\"" ws ":" ws null-or-string ws ","
  ws "\"time_or_status\"" ws ":" ws null-or-string ws ","
  ws "\"summary\"" ws ":" ws triplet ws ","
  ws "\"bantay_speech\"" ws ":" ws triplet ws ","
  ws "\"action_checklist\"" ws ":" ws steps ws ","
  ws "\"missing_warnings\"" ws ":" ws warnings ws ","
  ws "\"model_notice\"" ws ":" ws null-or-string ws "}"

source  ::= "{" ws "\"type\"" ws ":" ws ("\"text\"" / "\"ocr\"") ws ","
            ws "\"text\"" ws ":" ws string ws "}"

crisis_type ::= "\"FLOOD\"" / "\"FIRE\"" / "\"SECURITY\"" / "\"BLACKOUT\"" / "\"GENERAL\""
bantay_state ::= "\"ALERT\"" / "\"CAUTION\"" / "\"INFO\""
status  ::= "\"skeleton\"" / "\"enriched\"" / "\"failed\""
warning_code ::= "\"EVAC_CENTER\"" / "\"HOTLINE\"" / "\"ZONE\"" / "\"OTHER\""

triplet ::= "{" ws "\"en\"" ws ":" ws string ws ","
               ws "\"tl\"" ws ":" ws string ws ","
               ws "\"ceb\"" ws ":" ws string ws "}"

steps   ::= "[" ws step (ws "," ws step)* ws "]"
step    ::= "{" ws "\"id\"" ws ":" ws string ws ","
                ws "\"priority\"" ws ":" ws int ws ","
                ws "\"text\"" ws ":" ws triplet ws ","
                ws "\"origin\"" ws ":" ws ("\"template\"" / "\"llm\"") ws ","
                ws "\"state\"" ws ":" ws ("\"pending\"" / "\"done\"") ws "}"

warnings ::= "[" ws warning (ws "," ws warning)* ws "]"
warning ::= "{" ws "\"id\"" ws ":" ws string ws ","
                ws "\"code\"" ws ":" ws warning_code ws ","
                ws "\"text\"" ws ":" ws triplet ws ","
                ws "\"origin\"" ws ":" ws ("\"fastpath\"" / "\"llm\"") ws "}"

null-or-string ::= "null" / string

int     ::= [1-9] [0-9]*
string  ::= "\"" char* "\""
char    ::= [^"\\] / escape
escape  ::= "\\" ["\\/bfnrt] / "\\u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]
ws      ::= [ \t\n\r]*
